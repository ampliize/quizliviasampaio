# Chave da OpenAI (https://platform.openai.com/api-keys). Sem ela, o quiz usa as devolutivas prontas.
OPENAI_API_KEY=
# Modelo usado para escrever a devolutiva.
OPENAI_MODEL=gpt-4o-mini
# Opcional: para onde enviar cada lead concluído (n8n, Make, ManyChat, Supabase...).
LEAD_WEBHOOK_URL=
# Opcional: enviado no header X-Webhook-Secret para o webhook validar a origem.
LEAD_WEBHOOK_SECRET=
