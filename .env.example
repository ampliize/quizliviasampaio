# Chave da OpenAI (https://platform.openai.com/api-keys). Sem ela, o quiz usa as devolutivas prontas.
OPENAI_API_KEY=
# Modelo usado para escrever a devolutiva.
OPENAI_MODEL=gpt-4o-mini
# Mini CRM: projeto Supabase da Lívia (Project Settings > API). A service role fica só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Senha única do painel /crm.
CRM_SENHA=
